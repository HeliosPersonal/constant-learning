{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Quartz": "Information"
    }
  },
  "AllowedHosts": "*",
  
  "ConnectionStrings": {
    "_comment": "Рядок підключення PostgreSQL. У Docker: Host=postgres. Локально: Host=localhost",
    "DefaultConnection": "Host=postgres;Database=constantlearning;Username=postgres;Password=postgres"
  },
  
  "Telegram": {
    "_comment_BotToken": "Отримайте токен у Telegram через @BotFather. Формат: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz",
    "BotToken": "",
    "_comment_WebhookUrl": "Публічна адреса webhook. Формат: https://yourdomain.com/api/telegram/webhook",
    "_comment_WebhookUrl_ngrok": "Для локальної розробки через ngrok: https://abc123.ngrok.io/api/telegram/webhook",
    "_comment_WebhookUrl_note": "Залиште порожнім, щоб пропустити автоматичну реєстрацію webhook",
    "WebhookUrl": ""
  },
  
  "Learning": {
    "_comment": "Налаштуйте параметри навчання",
    "RepetitionWordsCount": 10,
    "NewWordsCount": 3,
    "AnswerDelaySeconds": 30,
    "LearnedWordsChunkSize": 10
  },
  
  "Language": {
    "_comment": "Змініть ці параметри, щоб обрати мовну пару. Мови інтерфейсу: 'uk' (українська), 'en' (англійська)",
    "_example_Polish": "TargetLanguage='Polish', TargetLanguageCode='pl'",
    "_example_English": "TargetLanguage='English', TargetLanguageCode='en'",
    "_example_Spanish": "TargetLanguage='Spanish', TargetLanguageCode='es'",
    
    "TargetLanguage": "Polish",
    "SourceLanguage": "Ukrainian",
    "TargetLanguageCode": "pl",
    "SourceLanguageCode": "uk"
  },
  
  "WordsImport": {
    "_comment": "Формат CSV: rank,target,source,transcription. Для англійської використовуйте: '/app/data/words-english.csv'",
    "CsvPath": "/app/data/words.csv"
  }
}
