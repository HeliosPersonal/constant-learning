<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
      <UserSecretsId>4e62d6d1-3fb1-45e2-a6eb-c1430f376643</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Infisical.Sdk" Version="3.0.4" />
        <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="10.0.3" />
        <PackageReference Include="NodaTime" Version="3.3.7" />
        <PackageReference Include="Telegram.Bot" Version="22.10.3.3" />
        <PackageReference Include="Quartz" Version="4.7.0" />
        <PackageReference Include="Quartz.Extensions.Hosting" Version="4.7.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <Content Update="Resources\BotMessages.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Include="Resources\Templates\*.html">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="Resources\Words\*.csv">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Content Update="Resources\Morphology\manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Update="Resources\Morphology\*.gz;Resources\Morphology\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="..\docs\dictionary\course.csv;..\docs\dictionary\evidence.jsonl;..\docs\dictionary\readiness.json;..\docs\dictionary\sources-manifest.json"
               Link="Resources\Dictionary\%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Folder Include="Migrations\" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="ConstantLearning.Tests" />
    </ItemGroup>
</Project>
