<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
      <UserSecretsId>4e62d6d1-3fb1-45e2-a6eb-c1430f376643</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Infisical.Sdk" />
        <PackageReference Include="EFCore.NamingConventions" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.OpenApi" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="Telegram.Bot" />
        <PackageReference Include="Quartz" />
        <PackageReference Include="Quartz.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <None Include="Resources\Templates\*.html">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="Resources\Words\*.csv">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Content Update="Resources\Morphology\manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Update="Resources\Morphology\*.gz;Resources\Morphology\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="..\docs\dictionary\course.csv;..\docs\dictionary\evidence.jsonl;..\docs\dictionary\readiness.json;..\docs\dictionary\sources-manifest.json"
               Link="Resources\Dictionary\%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <!-- Нові цільові мови: кожна в підкаталозі docs\dictionary\<lang>\ → Resources\Dictionary\<lang>\.
           Корінь (pl) виключено — його копіює правило вище байт-у-байт; review-queue.csv не постачаємо (імпортер його не читає). -->
      <Content Include="..\docs\dictionary\**\course.csv;..\docs\dictionary\**\evidence.jsonl;..\docs\dictionary\**\readiness.json;..\docs\dictionary\**\sources-manifest.json"
               Exclude="..\docs\dictionary\course.csv;..\docs\dictionary\evidence.jsonl;..\docs\dictionary\readiness.json;..\docs\dictionary\sources-manifest.json"
               Link="Resources\Dictionary\%(RecursiveDir)%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Folder Include="Migrations\" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="ConstantLearning.Tests" />
    </ItemGroup>
</Project>
